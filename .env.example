# App settings
APP_NAME=AI Interview Agent
HOST=0.0.0.0
PORT=5000
DEBUG=false
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5002,http://127.0.0.1:5002

# Choose the LLM provider: "gemini" or "openai"
# Use OpenAI for the backend speech stack (Whisper + TTS) and either provider for chat.
LLM_PROVIDER=openai

# Gemini / Google AI config
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI config
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# For Render or Vercel deploys, update these values with your live URLs.
# BACKEND_URL=https://your-render-app.onrender.com
# FRONTEND_URL=https://your-vercel-app.vercel.app
